{
  "mainBinaryName": "tetro-dev",
  "app": {
    "windows": [
      {
        "title": "Tetro Dev — Local testing",
        "width": 1100,
        "height": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Light",
        "decorations": true,
        "devtools": true,
        "minWidth": 740,
        "minHeight": 500
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "windows": {
      "signCommand": null,
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "scripts/windows/dev-installer-hooks.nsh"
      }
    }
  }
}
